{
  "name": "@wa/princess",
  "version": "0.1.0",
  "private": true,
  "description": "Princess Cruises site maps, crawlers, change reports and live lookups",
  "scripts": {
    "map:home": "node ../site-mapper/map-page.mjs https://www.princess.com/ ../../data/sites/princess.com home && node build-home-map.mjs",
    "build:home": "node build-home-map.mjs",
    "sitemap": "node fetch-sitemap.mjs && node build-content-index.mjs",
    "crawl:destinations": "node crawl.mjs destinations",
    "crawl:ships": "node crawl.mjs ships",
    "crawl:dining": "node crawl.mjs dining",
    "crawl:deals": "node crawl.mjs deals",
    "crawl:help": "node crawl.mjs help",
    "crawl:excursions": "node crawl-excursions.mjs",
    "report": "node compare.mjs",
    "map:services": "node map-services.mjs",
    "check:apis": "node check-apis.mjs && node build-api-report.mjs",
    "check:links": "node check-links.mjs",
    "audit:content": "node audit-content.mjs",
    "recheck:issues": "node recheck-issues.mjs",
    "daily": "node fetch-sitemap.mjs && node check-links.mjs && node check-apis.mjs && node recheck-issues.mjs && node build-daily-report.mjs",
    "report:daily": "node build-daily-report.mjs"
  }
}
